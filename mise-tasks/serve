#!/usr/bin/env bash
#MISE description="Serve a worktree for agent testing"
# Agent testing script: serve a worktree with a random port and pid file.
# Usage: mise run serve <worktree-name>
# Kill:   kill $(cat <worktree>/.serve.pid) or mise run serve-kill <worktree-name>

set -euo pipefail

# Ensure mise environment is active (for RUSTC_WRAPPER, tool paths)
if [ -z "${RUSTC_WRAPPER:-}" ] && command -v mise &>/dev/null; then
    eval "$(mise env)"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_DIR="$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel)"
CERT_DIR="$HOME/.local/share/ssl-certs/dev.localhost"
WORK_BASE="$HOME/work"
HOST="dev.localhost"
PID_FILE=".serve.pid"
PORT_FILE=".serve.port"

# ── helpers ──────────────────────────────────────────────────────────

die() { echo "error: $*" >&2; exit 1; }

find_worktree() {
    local name="$1"
    local dir="$WORK_BASE/$name"
    if [ -d "$dir" ] && [ -e "$dir/.git" ]; then
        echo "$dir"
    else
        # Try matching as a suffix
        for d in "$WORK_BASE"/khanatime-"$name"*; do
            if [ -d "$d" ] && [ -e "$d/.git" ]; then
                echo "$d"
                return
            fi
        done
        return 1
    fi
}

find_free_port() {
    # Pick a random port in 30000-59999 range, verify it's free
    while true; do
        port=$((RANDOM % 30000 + 30000))
        if ! ss -tln | grep -q ":$port "; then
            echo "$port"
            return
        fi
    done
}

# ── commands ─────────────────────────────────────────────────────────

do_serve() {
    local name="$1"
    local wt_dir
    wt_dir=$(find_worktree "$name") || die "Worktree not found: $name"

    # Kill existing serve if running
    if [ -f "$wt_dir/$PID_FILE" ]; then
        local old_pid
        old_pid=$(cat "$wt_dir/$PID_FILE")
        if kill -0 "$old_pid" 2>/dev/null; then
            echo "Stopping previous serve (pid $old_pid)..."
            kill "$old_pid" 2>/dev/null || true
            sleep 1
        fi
        rm -f "$wt_dir/$PID_FILE"
    fi

    local port
    port=$(find_free_port)

    # Save port for agent to read
    echo "$port" > "$wt_dir/$PORT_FILE"

    echo "═══════════════════════════════════════════════════════════════"
    printf '\033[1;33m  Serving %s on port %s\033[0m\n' "$(basename "$wt_dir")" "$port"
    echo "═══════════════════════════════════════════════════════════════"
    echo "  URL: https://$HOST:$port"
    echo "  PID file: $wt_dir/$PID_FILE"
    echo "  To stop:  kill \$(cat $wt_dir/$PID_FILE)"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""

    # Write PID before starting (so it's available immediately)
    echo $$ > "$wt_dir/$PID_FILE"

    # Clean up on exit
    cleanup() {
        rm -f "$wt_dir/$PID_FILE" "$wt_dir/$PORT_FILE"
    }
    trap cleanup EXIT

    # Serve (foreground) — mise env already active from `mise run`
    exec env \
        TRUNK_SERVE_DISABLE_ADDRESS_LOOKUP=true \
        TRUNK_SERVE_TLS_CERT_PATH="$CERT_DIR/cert.pem" \
        TRUNK_SERVE_TLS_KEY_PATH="$CERT_DIR/key.pem" \
        TRUNK_SERVE_WS_PROTOCOL=wss \
        trunk serve --port "$port"
}

do_stop() {
    local name="$1"
    local wt_dir
    wt_dir=$(find_worktree "$name") || die "Worktree not found: $name"

    if [ -f "$wt_dir/$PID_FILE" ]; then
        local pid
        pid=$(cat "$wt_dir/$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Stopping serve (pid $pid)..."
            kill "$pid"
            rm -f "$wt_dir/$PID_FILE" "$wt_dir/$PORT_FILE"
            echo "Stopped."
        else
            echo "Process $pid not running, cleaning up."
            rm -f "$wt_dir/$PID_FILE" "$wt_dir/$PORT_FILE"
        fi
    else
        echo "No serve running for $(basename "$wt_dir")."
    fi
}

do_status() {
    local name="${1:-}"
    if [ -n "$name" ]; then
        # Show status for specific worktree
        local wt_dir
        wt_dir=$(find_worktree "$name") || die "Worktree not found: $name"
        if [ -f "$wt_dir/$PID_FILE" ]; then
            local pid port
            pid=$(cat "$wt_dir/$PID_FILE")
            port=$(cat "$wt_dir/$PORT_FILE" 2>/dev/null || echo "?")
            if kill -0 "$pid" 2>/dev/null; then
                printf '\033[1;32m  %s: running (pid %s, port %s)\033[0m\n' "$(basename "$wt_dir")" "$pid" "$port"
            else
                printf '\033[1;31m  %s: stale pid %s\033[0m\n' "$(basename "$wt_dir")" "$pid"
            fi
        else
            printf '\033[2m  %s: not serving\033[0m\n' "$(basename "$wt_dir")"
        fi
    else
        # Show all worktrees
        echo "Worktree serve status:"
        for dir in "$WORK_BASE"/khanatime-*/; do
            [ -d "$dir" ] || continue
            [ -e "$dir/.git" ] || continue
            local name basename
            basename=$(basename "$dir")
            if [ -f "$dir/$PID_FILE" ]; then
                local pid port
                pid=$(cat "$dir/$PID_FILE")
                port=$(cat "$dir/$PORT_FILE" 2>/dev/null || echo "?")
                if kill -0 "$pid" 2>/dev/null; then
                    printf '  \033[1;32m%s: running (pid %s, port %s)\033[0m\n' "$basename" "$pid" "$port"
                else
                    printf '  \033[1;31m%s: stale pid %s\033[0m\n' "$basename" "$pid"
                fi
            else
                printf '  \033[2m%s: not serving\033[0m\n' "$basename"
            fi
        done
    fi
}

# ── usage ────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
Usage: mise run serve <command> [worktree-name]

Commands:
  start <name>    Start serving a worktree (random port)
  stop <name>     Stop serving a worktree
  status [name]   Show serve status

Examples:
  mise run serve start khanatime-qr-brave
  mise run serve stop khanatime-qr-brave
  mise run serve status
EOF
    exit 1
}

# ── main ─────────────────────────────────────────────────────────────

[ $# -lt 1 ] && usage

cmd="$1"
shift

case "$cmd" in
    start|serve)
        [ $# -lt 1 ] && die "Usage: mise run serve start <worktree-name>"
        do_serve "$1"
        ;;
    stop|kill)
        [ $# -lt 1 ] && die "Usage: mise run serve stop <worktree-name>"
        do_stop "$1"
        ;;
    status|st)
        do_status "${1:-}"
        ;;
    *)
        usage
        ;;
esac
